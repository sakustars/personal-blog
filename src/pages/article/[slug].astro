---
import { getCollection } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";
import ArticlePage from "../../components/ArticlePage.astro";
export async function getStaticPaths() {
  const posts = (await getCollection("posts", ({ data }) => data.lang === "zh" && !data.draft)).sort((a, b) => b.data.pubDatetime.valueOf() - a.data.pubDatetime.valueOf());
  return posts.map(post => ({ params: { slug: post.data.translationKey }, props: { post, posts } }));
}
const { post, posts } = Astro.props;
---
<SiteLayout title={`${post.data.title} — CARLEIGHT`} description={post.data.description} lang="zh" alternatePath={`/en/article/${post.data.translationKey}`}>
  <ArticlePage lang="zh" {post} {posts} />
</SiteLayout>
