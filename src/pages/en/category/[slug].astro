---
import { getCollection } from "astro:content";
import SiteLayout from "../../../layouts/SiteLayout.astro";
import CategoryPage from "../../../components/CategoryPage.astro";
import { categories } from "../../../data/categories";

export async function getStaticPaths() {
  const allPosts = (await getCollection("posts", ({ data }) => data.lang === "en" && !data.draft)).sort((a, b) => b.data.pubDatetime.valueOf() - a.data.pubDatetime.valueOf());
  return categories.map(category => ({ params: { slug: category.slug }, props: { category, posts: allPosts.filter(post => category.sourceCategories.includes(post.data.category as never)) } }));
}
const { category, posts } = Astro.props;
---
<SiteLayout title={`${category.en.title} — CARLEIGHT`} description={category.en.description} lang="en" alternatePath={`/category/${category.slug}`}>
  <CategoryPage lang="en" {category} {posts} />
</SiteLayout>

