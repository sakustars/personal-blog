---
import { getCollection } from "astro:content";
import SiteLayout from "../layouts/SiteLayout.astro";
import HomePage from "../components/HomePage.astro";
const posts = (await getCollection("posts", ({ data }) => data.lang === "zh" && !data.draft)).sort((a, b) => b.data.pubDatetime.valueOf() - a.data.pubDatetime.valueOf());
---
<SiteLayout title="CARLEIGHT — Writing" description="关于科学、技术、阅读与日常生活的个人写作。" lang="zh" alternatePath="/en/">
  <HomePage lang="zh" {posts} />
</SiteLayout>
