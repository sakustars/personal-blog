---
interface Props { lang: "zh" | "en" }
const { lang } = Astro.props;
const copy = lang === "zh"
  ? {
      intro: [
        "Writing on brain science, technology, reading, and everyday life.",
        "Interested in how minds learn, remember, and create.",
        "Always eager to study deeper & build better tools.",
      ],
      journey: "Journey",
      based: "Based",
      guestBook: "Guest Book",
      site: "About This Site",
      guestCopy: [
        "Hey, Carleight! You can leave any message here.",
        "The message is only visible to you and me. You can only submit one message per 24 hours.",
        "I may reply to you via your email (1003304159@qq.com).",
      ],
    }
  : {
      intro: [
        "Writing on brain science, technology, reading, and everyday life.",
        "Interested in how minds learn, remember, and create.",
        "Always eager to study deeper & build better tools.",
      ],
      journey: "Journey",
      based: "Based",
      guestBook: "Guest Book",
      site: "About This Site",
      guestCopy: [
        "Hey, Carleight! You can leave any message here.",
        "The message is only visible to you and me. You can only submit one message per 24 hours.",
        "I may reply to you via your email (1003304159@qq.com).",
      ],
    };
const links = [
  { label: "Email", href: "mailto:1003304159@qq.com" },
  { label: "GitHub", href: "https://github.com/sakustars" },
  { label: "Twitter", href: "https://twitter.com/" },
  { label: "Telegram", href: "https://t.me/" },
];
const journey = [
  { date: "2026 — Now", title: "Independent study in brain science & neuroscience", place: "Singapore", description: "Building a personal knowledge system around cognition, memory, learning, and scientific methods." },
  { date: "2025 — Now", title: "Personal blog & research notes", place: "Online", description: "Writing about science, technology, reading, and everyday observations." },
  { date: "2024 — 2025", title: "Software, AI tools, and systems learning", place: "Remote", description: "Exploring practical tools that make study, writing, and creation easier." },
  { date: "Earlier", title: "Long-term curiosity about minds and machines", place: "Everywhere", description: "Reading, collecting notes, and turning vague questions into clearer research directions." },
];
const siteHistory = [
  { date: "Aug. 2026", title: "New Design.", body: "A quieter personal homepage inspired by read.cv-style editorial typography." },
  { date: "Aug. 2026", title: "Blog as a Subpage.", body: "Moved writing into a dedicated Blog page so the homepage can focus on Carleight." },
  { date: "Aug. 2026", title: "Cloudflare Deployment.", body: "GitHub Actions deploys the static Astro site to Cloudflare Pages after each push." },
];
---
<main class="about-page">
  <section class="about-intro" aria-labelledby="about-title">
    <h1 id="about-title">CARLEIGHT</h1>
    <p>{copy.intro.map(line => <><span>{line}</span><br /></>)}</p>
    <nav class="about-links" aria-label={lang === "zh" ? "联系方式" : "Contact links"}>
      {links.map(link => <a href={link.href} target="_blank" rel="noreferrer">{link.label}↗</a>)}
    </nav>
  </section>

  <section class="about-section" aria-labelledby="journey-title">
    <h2 id="journey-title">{copy.journey}</h2>
    <div class="about-timeline">
      {journey.map(item => (
        <article class="about-timeline-item">
          <time>{item.date}</time>
          <div>
            <h3>{item.title}</h3>
            <p class="muted-line">{item.place}</p>
            <p class="timeline-description">{item.description}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="about-section based-section" aria-labelledby="based-title">
    <h2 id="based-title">{copy.based}</h2>
    <div class="map-card" role="img" aria-label="Map centered around Hangzhou, China">
      <div class="map-grid"></div>
      <div class="map-city city-hangzhou">Hangzhou</div>
      <div class="map-city city-shanghai">Shanghai</div>
      <div class="map-city city-suzhou">Suzhou</div>
      <div class="map-city city-ningbo">Ningbo</div>
      <div class="location-marker"></div>
      <div class="plane-marker">✈</div>
      <div class="map-label">Hangzhou, China</div>
      <a class="map-expand" href="https://www.openstreetmap.org/search?query=Hangzhou%2C%20China" target="_blank" rel="noreferrer" aria-label="Open Hangzhou map">↗</a>
    </div>
  </section>

  <section class="about-section guest-section" aria-labelledby="guest-title">
    <h2 id="guest-title">{copy.guestBook}</h2>
    <div class="guest-copy">{copy.guestCopy.map(line => <p>{line}</p>)}</div>
    <form class="guest-form" data-guest-book>
      <div class="message-box">
        <textarea name="message" placeholder="Say Something..." maxlength="800"></textarea>
        <button type="submit">Submit</button>
      </div>
      <p class="guest-status" data-guest-status></p>
    </form>
  </section>

  <section class="about-section about-site-section" aria-labelledby="site-title">
    <header class="about-site-heading">
      <h2 id="site-title">{copy.site}</h2>
      <button type="button" aria-label="Toggle About This Site" data-toggle-site>
        <svg width="18" height="28" viewBox="0 0 18 28" fill="none" aria-hidden="true"><path d="M3 10L9 4L15 10" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/><path d="M3 18L9 24L15 18" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </header>
    <div class="about-timeline" data-site-timeline>
      {siteHistory.map(item => (
        <article class="about-timeline-item">
          <time>{item.date}</time>
          <div><h3>{item.title}</h3><p class="timeline-description">{item.body}</p></div>
        </article>
      ))}
    </div>
  </section>
</main>

<script>
  document.querySelector<HTMLFormElement>("[data-guest-book]")?.addEventListener("submit", event => {
    event.preventDefault();
    const form = event.currentTarget as HTMLFormElement;
    const status = form.querySelector<HTMLElement>("[data-guest-status]");
    if (status) status.textContent = "Guest Book backend is coming soon. Your message is not submitted yet.";
  });
  document.querySelector<HTMLButtonElement>("[data-toggle-site]")?.addEventListener("click", event => {
    const timeline = document.querySelector<HTMLElement>("[data-site-timeline]");
    const button = event.currentTarget as HTMLButtonElement;
    if (!timeline) return;
    const hidden = timeline.toggleAttribute("hidden");
    button.setAttribute("aria-expanded", String(!hidden));
  });
</script>
