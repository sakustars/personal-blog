---
import LoginPanel from "./LoginPanel.astro";

interface Props {
  lang: "zh" | "en";
}

const { lang } = Astro.props;
---

<section class="login-page" data-login-page>
  <LoginPanel {lang} />
</section>
<script>
  const params = new URLSearchParams(location.search);
  const requested = params.get("return_to");
  const returnTo =
    requested?.startsWith("/") && !requested.startsWith("//")
      ? requested
      : location.pathname.startsWith("/en/")
        ? "/en/account/"
        : "/account/";
  document
    .querySelectorAll<HTMLAnchorElement>("[data-provider]")
    .forEach(link => {
      link.href = `/api/auth/${link.dataset.provider}?return_to=${encodeURIComponent(returnTo)}`;
    });

  fetch("/api/auth/providers", { credentials: "same-origin" })
    .then(response => (response.ok ? response.json() : null))
    .then(data => {
      if (!data) return;
      const links = Array.from(
        document.querySelectorAll<HTMLAnchorElement>("[data-provider]")
      );
      let available = 0;
      links.forEach(link => {
        const provider = link.dataset.provider || "";
        const enabled = Boolean(data?.providers?.[provider]);
        link.classList.toggle("is-unavailable", !enabled);
        link.setAttribute("aria-disabled", String(!enabled));
        if (enabled) {
          available += 1;
          link.removeAttribute("tabindex");
        } else {
          link.setAttribute("tabindex", "-1");
          link.addEventListener("click", event => event.preventDefault());
        }
      });
      const status = document.querySelector<HTMLElement>("[data-login-status]");
      if (status) status.hidden = available > 0;
    })
    .catch(() => {});
</script>
