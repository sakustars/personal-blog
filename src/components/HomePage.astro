---
import type { CollectionEntry } from "astro:content";
import Cover from "./Cover.astro";
import { categories } from "../data/categories";

interface Props {
  lang: "zh" | "en";
  posts: CollectionEntry<"posts">[];
}
const { lang, posts } = Astro.props;
const featured = posts.find(post => post.data.featured) ?? posts[0];
const others = posts.filter(post => post.id !== featured.id);
const urlFor = (post: CollectionEntry<"posts">) =>
  lang === "zh"
    ? `/article/${post.data.translationKey}`
    : `/en/article/${post.data.translationKey}`;
const date = (value: Date) =>
  new Intl.DateTimeFormat(lang === "zh" ? "zh-CN" : "en-US", {
    year: "numeric",
    month: lang === "zh" ? "long" : "short",
    day: "numeric",
  }).format(value);
const category = (value: string) => {
  if (lang === "en") return value === "Cognition" ? "Notes" : "Science";
  return value === "Cognition" ? "笔记" : "科学";
};
const searchText = (post: CollectionEntry<"posts">) =>
  [
    post.data.title,
    post.data.description,
    post.data.deck,
    category(post.data.category),
    date(post.data.pubDatetime),
    post.data.tags.join(" "),
    post.body,
  ]
    .filter(Boolean)
    .join(" ");
const copy =
  lang === "zh"
    ? {
        title: "Carleight Blog",
        intro:
          "关于科学、技术、阅读与日常生活的个人写作。有些来自长期研究，有些只是尚未想完的笔记。",
        areas: ["Essays", "Science", "Technology", "Reading"],
        latest: "最新文章",
        archive: "所有文章",
        read: "继续阅读",
        date: "日期",
        category: "栏目",
        titleLabel: "标题",
        search: "搜索文章",
        empty: "没有找到相关文章",
      }
    : {
        title: "Carleight Blog",
        intro:
          "Personal writing on science, technology, reading, and everyday life. Some pieces grow from long research; others remain notes in progress.",
        areas: ["Essays", "Science", "Technology", "Reading"],
        latest: "Latest writing",
        archive: "All writing",
        read: "Continue reading",
        date: "Date",
        category: "Section",
        titleLabel: "Title",
        search: "Search writing",
        empty: "No matching writing found",
      };
---

<section class="home-hero">
  <div class="hero-copy"><h1>{copy.title}</h1><p>{copy.intro}</p></div>
  <nav
    class="hero-category-list"
    aria-label={lang === "zh" ? "文章栏目" : "Writing sections"}
  >
    {
      copy.areas.map((item, index) => (
        <a
          href={`${lang === "zh" ? "/category" : "/en/category"}/${categories[index].slug}`}
        >
          <>
            <span>{item}</span>
            <span aria-hidden="true">→</span>
          </>
        </a>
      ))
    }
  </nav>
</section>

<section class="writing-section" id="writing">
  <div class="section-heading">
    <h2>{copy.latest}</h2><span
      >{posts.length} {lang === "zh" ? "篇" : "posts"}</span>
  </div>
  <div class="feature-grid">
    <a class="feature-story" href={urlFor(featured)}>
      <Cover type={featured.data.cover} large />
      <div class="feature-caption">
        <h3>{featured.data.title}</h3>
        <div class="feature-summary">
          <div class="story-meta">
            <span>{category(featured.data.category)}</span><span
              >{date(featured.data.pubDatetime)}</span>
          </div>
          <p>{featured.data.description}</p>
          <span class="text-link">{copy.read} →</span>
        </div>
      </div>
    </a>
    <div class="latest-list">
      {
        others.map(post => (
          <a href={urlFor(post)} class="latest-item">
            <div class="story-meta">
              <>
                <span>{category(post.data.category)}</span>
                <span>{date(post.data.pubDatetime)}</span>
              </>
            </div>
            <>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
            </>
          </a>
        ))
      }
    </div>
  </div>
</section>

<section class="archive-section" id="archive" data-post-search>
  <div class="archive-heading">
    <h2>{copy.archive}</h2>
    <label class="archive-search">
      <svg viewBox="0 0 24 24" aria-hidden="true"
        ><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4 4"
        ></path></svg
      >
      <input
        data-search-input
        type="search"
        placeholder={copy.search}
        aria-label={copy.search}
        autocomplete="off"
      />
    </label>
  </div>
  <div class="archive-table">
    <div class="archive-labels">
      <span>{copy.date}</span><span>{copy.category}</span><span
        >{copy.titleLabel}</span>
    </div>
    {
      posts.map(post => (
        <a
          href={urlFor(post)}
          data-archive-row
          data-search-row
          data-search={searchText(post)}
        >
          <>
            <span>{date(post.data.pubDatetime)}</span>
            <span>{category(post.data.category)}</span>
            <strong>{post.data.title}</strong>
          </>
        </a>
      ))
    }
    <p class="archive-empty" data-search-empty hidden>{copy.empty}</p>
  </div>
  <p
    class="archive-status"
    aria-live="polite"
    data-search-status
    data-singular={lang === "zh" ? "篇" : "post"}
    data-plural={lang === "zh" ? "篇" : "posts"}
  >
    <span data-search-count>{posts.length}</span>
    <span data-count-label
      >{lang === "zh" ? "篇" : posts.length === 1 ? "post" : "posts"}</span>
  </p>
</section>

<script>
  import { setupPostSearch } from "../scripts/postSearch";
  setupPostSearch();
</script>
