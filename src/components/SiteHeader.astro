---
interface Props { lang: "zh" | "en"; alternatePath: string }
const { lang, alternatePath } = Astro.props;
const pathname = Astro.url.pathname;
const home = lang === "zh" ? "/" : "/en/";
const blog = lang === "zh" ? "/blog/" : "/en/blog/";
const friends = lang === "zh" ? "/friends/" : "/en/friends/";
const isAbout = pathname === home;
const isBlog = pathname.startsWith(blog) || pathname.includes("/article/") || pathname.includes("/category/");
const isFriends = pathname.startsWith(friends);
---
<header class="site-header">
  <div class="header-inner">
    <a class="wordmark" href={home}>CARLEIGHT</a>
    <nav aria-label={lang === "zh" ? "主导航" : "Main navigation"}>
      <a class:list={{ active: isAbout }} href={home}>About</a>
      <a class:list={{ active: isBlog }} href={blog}>Blog</a>
      <a class:list={{ active: isFriends }} href={friends}>Friends</a>
    </nav>
    <div class="account-area">
      <a class="github-login" href={`/api/auth/github?return_to=${encodeURIComponent(pathname)}`} data-github-login data-login-label={lang === "zh" ? "登录" : "Login"} data-logout-label={lang === "zh" ? "退出登录" : "Logout"}>
        <span class="github-avatar" data-account-avatar aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="7" r="4"></circle><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"></path></svg>
        </span>
        <span data-account-label>{lang === "zh" ? "登录" : "Login"}</span>
      </a>
      <div class="language-switch" aria-label="Language">
        <a class:list={{ active: lang === "zh" }} data-language="zh" href={lang === "zh" ? pathname : alternatePath}>中</a>
        <span>/</span>
        <a class:list={{ active: lang === "en" }} data-language="en" href={lang === "en" ? pathname : alternatePath}>EN</a>
      </div>
      <button class="theme-toggle" type="button" aria-label={lang === "zh" ? "切换明暗模式" : "Toggle color theme"} aria-pressed="false">
        <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 15.2A8.2 8.2 0 0 1 8.8 4a8.3 8.3 0 1 0 11.2 11.2Z"></path></svg>
        <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3.8"></circle><path d="M12 2v2.1M12 19.9V22M2 12h2.1M19.9 12H22M4.9 4.9l1.5 1.5M17.6 17.6l1.5 1.5M19.1 4.9l-1.5 1.5M6.4 17.6l-1.5 1.5"></path></svg>
      </button>
    </div>
  </div>
</header>

<script>
  const accountLabel = document.querySelector<HTMLElement>("[data-account-label]");
  const loginLink = document.querySelector<HTMLAnchorElement>("[data-github-login]");
  const avatar = document.querySelector<HTMLElement>("[data-account-avatar]");
  const returnTo = `${location.pathname}${location.search}${location.hash}`;

  if (loginLink) loginLink.href = `/api/auth/github?return_to=${encodeURIComponent(returnTo)}`;

  fetch("/api/auth/me", { credentials: "include" })
    .then(response => response.ok ? response.json() : { authenticated: false })
    .then(data => {
      if (!loginLink || !accountLabel) return;
      if (!data?.authenticated || !data?.user?.login) {
        accountLabel.textContent = loginLink.dataset.loginLabel || "Login";
        return;
      }

      const user = data.user;
      accountLabel.textContent = user.name || user.login;
      loginLink.href = `/api/auth/logout?return_to=${encodeURIComponent(returnTo)}`;
      loginLink.title = loginLink.dataset.logoutLabel || "Logout";
      loginLink.setAttribute("aria-label", `${user.name || user.login} — ${loginLink.dataset.logoutLabel || "Logout"}`);

      if (avatar && user.avatar_url) {
        avatar.innerHTML = "";
        const image = document.createElement("img");
        image.src = user.avatar_url;
        image.alt = "";
        image.loading = "lazy";
        avatar.append(image);
      }
    })
    .catch(() => {
      if (accountLabel && loginLink) accountLabel.textContent = loginLink.dataset.loginLabel || "Login";
    });
</script>
