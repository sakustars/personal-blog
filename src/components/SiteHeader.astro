---
interface Props { lang: "zh" | "en"; alternatePath: string }
const { lang, alternatePath } = Astro.props;
const pathname = Astro.url.pathname;
const home = lang === "zh" ? "/" : "/en/";
const blog = lang === "zh" ? "/blog/" : "/en/blog/";
const friends = lang === "zh" ? "/friends/" : "/en/friends/";
const isAbout = pathname === home;
const isBlog = pathname.startsWith(blog) || pathname.includes("/article/") || pathname.includes("/category/");
const isFriends = pathname.startsWith(friends);
const labels = { about: "About", blog: "Blog", friends: "Friends", login: "GitHub" };
---
<header class="site-header">
  <div class="header-inner">
    <a class="wordmark" href={home}>CARLEIGHT</a>
    <nav aria-label={lang === "zh" ? "主导航" : "Main navigation"}>
      <a class:list={{ active: isAbout }} href={home}>{labels.about}</a>
      <a class:list={{ active: isBlog }} href={blog}>{labels.blog}</a>
      <a class:list={{ active: isFriends }} href={friends}>{labels.friends}</a>
    </nav>
    <div class="account-area">
      <a class="github-login" href="/api/auth/github" data-github-login>
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="7" r="4"></circle><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"></path></svg>
        <span data-account-label>{labels.login}</span>
      </a>
      <div class="language-switch" aria-label="Language">
        <a class:list={{ active: lang === "zh" }} data-language="zh" href={lang === "zh" ? pathname : alternatePath}>中</a>
        <span>/</span>
        <a class:list={{ active: lang === "en" }} data-language="en" href={lang === "en" ? pathname : alternatePath}>EN</a>
      </div>
    </div>
  </div>
</header>

<script>
  const accountLabel = document.querySelector<HTMLElement>("[data-account-label]");
  const loginLink = document.querySelector<HTMLAnchorElement>("[data-github-login]");
  fetch("/api/auth/me")
    .then(response => response.ok ? response.json() : null)
    .then(user => {
      if (!user?.login || !accountLabel || !loginLink) return;
      accountLabel.textContent = user.name || user.login;
      loginLink.href = "/api/auth/logout";
      loginLink.title = "Logout";
    })
    .catch(() => {});
</script>
