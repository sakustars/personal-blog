---
interface Props { lang: "zh" | "en"; alternatePath: string }
const { lang, alternatePath } = Astro.props;
const home = lang === "zh" ? "/" : "/en/";
const labels = lang === "zh" ? { articles: "文章", archive: "归档", about: "关于" } : { articles: "Writing", archive: "Archive", about: "About" };
---
<header class="site-header">
  <div class="header-main">
    <div class="header-inner">
      <a class="wordmark" href={home}>CARLEIGHT</a>
      <nav aria-label={lang === "zh" ? "主导航" : "Main navigation"}>
        <a href={`${home}#writing`}>{labels.articles}</a>
        <a href={`${home}#archive`}>{labels.archive}</a>
        <a href={`${home}#about`}>{labels.about}</a>
      </nav>
      <div class="language-switch" aria-label="Language">
        <a class:list={{ active: lang === "zh" }} data-language="zh" href={lang === "zh" ? Astro.url.pathname : alternatePath}>中</a>
        <span>/</span>
        <a class:list={{ active: lang === "en" }} data-language="en" href={lang === "en" ? Astro.url.pathname : alternatePath}>EN</a>
      </div>
      <button class="theme-toggle" type="button" aria-label={lang === "zh" ? "切换明暗模式" : "Toggle color mode"}>
        <svg class="theme-icon theme-icon-moon" viewBox="0 0 20 20" aria-hidden="true"><path d="M15.7 13.5A7 7 0 0 1 6.5 4.3 6 6 0 1 0 15.7 13.5Z"/></svg>
        <svg class="theme-icon theme-icon-sun" viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="3.2"/><path d="M10 1.5v2M10 16.5v2M1.5 10h2M16.5 10h2M4 4l1.4 1.4M14.6 14.6 16 16M16 4l-1.4 1.4M5.4 14.6 4 16"/></svg>
      </button>
    </div>
  </div>
</header>
