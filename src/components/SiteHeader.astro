---
import LoginPanel from "./LoginPanel.astro";

interface Props {
  lang: "zh" | "en";
}
const { lang } = Astro.props;
const pathname = Astro.url.pathname;
const home = lang === "zh" ? "/" : "/en/";
const blog = lang === "zh" ? "/blog/" : "/en/blog/";
const friends = lang === "zh" ? "/friends/" : "/en/friends/";
const login = lang === "zh" ? "/login/" : "/en/login/";
const account = lang === "zh" ? "/account/" : "/en/account/";
const isAbout = pathname === home;
const isBlog =
  pathname.startsWith(blog) ||
  pathname.includes("/article/") ||
  pathname.includes("/category/");
const isFriends = pathname.startsWith(friends);
const isLoginPage = pathname === login;
---

<header class="site-header">
  <div class="header-inner">
    <a class="wordmark" href={home}>Carleight</a>
    <nav aria-label={lang === "zh" ? "主导航" : "Main navigation"}>
      <a class:list={{ active: isAbout }} href={home}
        >{lang === "zh" ? "关于" : "About"}</a
      >
      <a class:list={{ active: isBlog }} href={blog}
        >{lang === "zh" ? "博客" : "Blog"}</a
      >
      <a class:list={{ active: isFriends }} href={friends}
        >{lang === "zh" ? "友人" : "Friends"}</a
      >
    </nav>
    <div class="account-area">
      <div class="account-control" data-account-root data-lang={lang}>
        <a
          class="account-login"
          href={`${login}?return_to=${encodeURIComponent(pathname)}`}
          data-account-login
        >
          <span
            class="account-avatar account-avatar-placeholder"
            aria-hidden="true"
          >
            <svg viewBox="0 0 24 24" fill="none"
              ><circle cx="12" cy="7" r="4"></circle><path
                d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"></path></svg
            >
          </span>
          <span>{lang === "zh" ? "登录" : "Login"}</span>
        </a>
        <button
          class="account-trigger"
          type="button"
          aria-expanded="false"
          aria-haspopup="menu"
          data-account-trigger
          hidden
        >
          <span class="account-avatar" data-account-avatar></span>
          <span data-account-name></span>
          <svg class="account-chevron" viewBox="0 0 16 16" aria-hidden="true"
            ><path d="m4 6 4 4 4-4"></path></svg
          >
        </button>
        <div class="account-menu" role="menu" data-account-menu hidden>
          <div class="account-menu-greeting">
            <span class="account-avatar account-avatar-large" data-menu-avatar
            ></span>
            <div>
              <strong data-account-greeting></strong><span data-account-email
              ></span>
            </div>
          </div>
          <a role="menuitem" href={account}>
            <svg viewBox="0 0 24 24" aria-hidden="true"
              ><circle cx="10" cy="7" r="3.5"></circle><path
                d="M3.5 20c0-3.8 2.9-6.5 6.5-6.5 1.5 0 2.8.4 3.9 1.2M18 14v2M18 20v2M14 18h2M20 18h2"
              ></path></svg
            >
            {lang === "zh" ? "用户中心" : "Account"}
          </a>
          <a
            class="account-logout"
            role="menuitem"
            href={`/api/auth/logout?return_to=${encodeURIComponent(home)}`}
          >
            <svg viewBox="0 0 24 24" aria-hidden="true"
              ><path d="M10 4H4v16h6M14 8l4 4-4 4M8 12h10"></path></svg
            >
            {lang === "zh" ? "退出登录" : "Sign out"}
          </a>
        </div>
      </div>
    </div>
  </div>
</header>

{
  !isLoginPage && (
    <section
      class="login-overlay"
      role="dialog"
      aria-modal="true"
      aria-labelledby="login-overlay-title"
      aria-hidden="true"
      data-login-overlay
      hidden
    >
      <LoginPanel {lang} overlay />
    </section>
  )
}

<script>
  const root = document.querySelector<HTMLElement>("[data-account-root]");
  const loginLink = root?.querySelector<HTMLAnchorElement>(
    "[data-account-login]"
  );
  const trigger = root?.querySelector<HTMLButtonElement>(
    "[data-account-trigger]"
  );
  const menu = root?.querySelector<HTMLElement>("[data-account-menu]");
  const loginOverlay = document.querySelector<HTMLElement>(
    "[data-login-overlay]"
  );
  const loginPanel =
    loginOverlay?.querySelector<HTMLElement>("[data-login-panel]");
  const loginClose =
    loginOverlay?.querySelector<HTMLButtonElement>("[data-login-close]");
  const lang = root?.dataset.lang || "en";
  let previouslyFocused: HTMLElement | null = null;
  let providerStatusLoaded = false;

  const overlayFocusables = () =>
    Array.from(
      loginOverlay?.querySelectorAll<HTMLElement>(
        'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'
      ) || []
    ).filter(element => !element.hidden);

  const syncProviderLinks = () => {
    if (!loginOverlay) return;
    const returnTo = `${location.pathname}${location.search}`;
    loginOverlay
      .querySelectorAll<HTMLAnchorElement>("[data-provider]")
      .forEach(link => {
        link.href = `/api/auth/${link.dataset.provider}?return_to=${encodeURIComponent(returnTo)}`;
      });
  };

  const loadProviderStatus = async () => {
    if (!loginOverlay || providerStatusLoaded) return;
    const statusNode = loginOverlay.querySelector<HTMLElement>(
      "[data-login-status]"
    );
    try {
      const response = await fetch("/api/auth/providers", {
        credentials: "same-origin",
      });
      if (!response.ok) return;
      const data = await response.json();
      const links = Array.from(
        loginOverlay.querySelectorAll<HTMLAnchorElement>("[data-provider]")
      );
      let available = 0;
      links.forEach(link => {
        const provider = link.dataset.provider || "";
        const enabled = Boolean(data?.providers?.[provider]);
        link.classList.toggle("is-unavailable", !enabled);
        link.setAttribute("aria-disabled", String(!enabled));
        if (enabled) {
          available += 1;
          link.removeAttribute("tabindex");
        } else {
          link.setAttribute("tabindex", "-1");
        }
      });
      if (statusNode) statusNode.hidden = available > 0;
      providerStatusLoaded = true;
    } catch {
      // Keep the links usable if the status endpoint is temporarily unavailable.
    }
  };

  const closeLogin = () => {
    if (!loginOverlay || loginOverlay.hidden) return;
    loginOverlay.hidden = true;
    loginOverlay.setAttribute("aria-hidden", "true");
    document.documentElement.classList.remove("login-overlay-open");
    previouslyFocused?.focus();
  };

  const openLogin = () => {
    if (!loginOverlay) return;
    previouslyFocused =
      document.activeElement instanceof HTMLElement
        ? document.activeElement
        : null;
    syncProviderLinks();
    void loadProviderStatus();
    loginOverlay.hidden = false;
    loginOverlay.setAttribute("aria-hidden", "false");
    document.documentElement.classList.add("login-overlay-open");
    requestAnimationFrame(() => loginClose?.focus());
  };
  const closeMenu = () => {
    if (!trigger || !menu) return;
    trigger.setAttribute("aria-expanded", "false");
    menu.hidden = true;
  };
  const setAvatar = (
    target: Element | null,
    source: string | null,
    name: string
  ) => {
    if (!target) return;
    target.replaceChildren();
    if (source) {
      const image = document.createElement("img");
      image.src = source;
      image.alt = "";
      image.loading = "lazy";
      target.append(image);
    } else {
      const fallback = document.createElement("span");
      fallback.textContent = name.slice(0, 1).toUpperCase();
      target.append(fallback);
    }
  };
  trigger?.addEventListener("click", () => {
    if (!menu) return;
    const opening = menu.hidden;
    menu.hidden = !opening;
    trigger.setAttribute("aria-expanded", String(opening));
  });
  loginLink?.addEventListener("click", event => {
    if (!loginOverlay) return;
    event.preventDefault();
    openLogin();
  });
  loginClose?.addEventListener("click", closeLogin);
  loginOverlay?.addEventListener("click", event => {
    if (event.target === loginOverlay) closeLogin();
  });
  loginPanel?.addEventListener("click", event => event.stopPropagation());
  loginPanel?.addEventListener("click", event => {
    const link = (event.target as Element).closest<HTMLAnchorElement>(
      '[data-provider][aria-disabled="true"]'
    );
    if (link) event.preventDefault();
  });
  loginOverlay?.addEventListener("keydown", event => {
    if (event.key !== "Tab") return;
    const focusable = overlayFocusables();
    if (!focusable.length) return;
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  });
  document.addEventListener("click", event => {
    if (root && !root.contains(event.target as Node)) closeMenu();
  });
  document.addEventListener("keydown", event => {
    if (event.key === "Escape") {
      closeMenu();
      closeLogin();
    }
  });

  fetch("/api/auth/me", { credentials: "include" })
    .then(response =>
      response.ok ? response.json() : { authenticated: false }
    )
    .then(data => {
      if (!data?.authenticated || !data?.user || !root || !trigger) return;
      const user = data.user;
      const name = user.name || user.login || (lang === "zh" ? "用户" : "User");
      if (loginLink) loginLink.hidden = true;
      closeLogin();
      trigger.hidden = false;
      const nameNode = root.querySelector<HTMLElement>("[data-account-name]");
      const greeting = root.querySelector<HTMLElement>(
        "[data-account-greeting]"
      );
      const email = root.querySelector<HTMLElement>("[data-account-email]");
      if (nameNode) nameNode.textContent = name;
      if (greeting)
        greeting.textContent =
          lang === "zh" ? `👋 嗨，${name}。` : `👋 Hello, ${name}.`;
      if (email) email.textContent = user.email || `@${user.login}`;
      setAvatar(
        root.querySelector("[data-account-avatar]"),
        user.avatar_url,
        name
      );
      setAvatar(
        root.querySelector("[data-menu-avatar]"),
        user.avatar_url,
        name
      );
    })
    .catch(() => {});
</script>
